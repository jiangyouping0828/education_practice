# 编辑器统一行为配置（VS Code / PyCharm / Vim 均自动生效）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{yaml,yml,json,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # Markdown 行尾双空格表示换行
